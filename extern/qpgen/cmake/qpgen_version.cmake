# Writes OUT_FILE with the qpgen version and the git commit of SRC_DIR. Run at every build
# (see CMakeLists.txt) so the commit is never stale; the file is rewritten only when its
# content changes, so an unchanged commit does not trigger recompilation.
#   cmake -DSRC_DIR=... -DOUT_FILE=... -DQPGEN_VERSION=x.y.z -P qpgen_version.cmake
set(QPGEN_GIT "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC_DIR} rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE _hash RESULT_VARIABLE _rc ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_rc EQUAL 0 AND _hash)
        set(QPGEN_GIT "${_hash}")
        # "-dirty" when tracked files differ from the commit (untracked files are ignored)
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC_DIR} diff --quiet HEAD --
                        RESULT_VARIABLE _dirty ERROR_QUIET)
        if(NOT _dirty EQUAL 0)
            set(QPGEN_GIT "${QPGEN_GIT}-dirty")
        endif()
    endif()
endif()
set(_content "// Generated by cmake/qpgen_version.cmake; do not edit\n#define QPGEN_VERSION \"${QPGEN_VERSION}\"\n#define QPGEN_GIT \"${QPGEN_GIT}\"\n")
if(EXISTS "${OUT_FILE}")
    file(READ "${OUT_FILE}" _old)
else()
    set(_old "")
endif()
if(NOT _content STREQUAL _old)
    file(WRITE "${OUT_FILE}" "${_content}")
endif()
